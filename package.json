{
  "name": "indorse",
  "scripts": {
    "android": "expo run:android",
    "android:build": "expo prebuild -p android",
    "api:dev": "npx -y tsx scripts/serve-api.ts",
    "build": "tsc --noEmit && npm run android:build",
    "ci": "tsc --noEmit && npm run lint:check && npm run format:check && npm run test && npm run android:build",
    "dev": "expo start --clear --dev-client --reset-cache",
    "dev:tunnel": "bash scripts/tunnel-watchdog.sh",
    "doctor": "npx -y expo-doctor@latest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "icons": "node scripts/generate-icons.mjs",
    "sas:bootstrap": "npx -y tsx scripts/bootstrap-sas.ts",
    "idl:sync": "cp programs/indorse_program/target/idl/indorse_program.json lib/idl/indorse_program.json",
    "client:generate": "node scripts/generate-client.mjs",
    "ios": "expo run:ios",
    "lint": "expo lint --fix",
    "lint:check": "expo lint",
    "start": "expo start",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "web": "expo start --web"
  },
  "displayName": "indorse",
  "description": "A Solana mobile dApp for decentralised farm scouting and parametric weather crop insurance, built with Expo, React Native, and Solana Kit.",
  "usecase": "Mobile",
  "keywords": [
    "expo",
    "mobile-wallet-adapter",
    "react-native",
    "solana-kit",
    "agriculture",
    "parametric-insurance"
  ],
  "main": "./index.js",
  "version": "1.0.0",
  "dependencies": {
    "@expo-google-fonts/great-vibes": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/space-grotesk": "^0.4.1",
    "@expo/metro-runtime": "~57.0.5",
    "@expo/vector-icons": "^15.1.1",
    "@noble/hashes": "1.8.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-clipboard/clipboard": "^1.16.3",
    "@rn-primitives/dropdown-menu": "^1.2.0",
    "@solana/kit": "^7.0.0",
    "@solana/program-client-core": "^7.1.1",
    "@solana/spl-token": "^0.4.15",
    "@solana/wallet-standard-util": "^1.1.4",
    "@solana/web3.js": "^1.99.0",
    "@tanstack/react-query": "^5.90.7",
    "@wallet-ui/react-native-kit": "^4.2.1",
    "expo": "~57.0.6",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.5",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-haptics": "~57.0.1",
    "expo-image": "~57.0.1",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.3",
    "expo-local-authentication": "~57.0.3",
    "expo-location": "~57.0.20",
    "expo-notifications": "~57.0.21",
    "expo-router": "~57.0.6",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "~57.0.1",
    "js-base64": "^3.7.8",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-icons": "^5.7.0",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-get-random-values": "~1.11.0",
    "react-native-nitro-modules": "^0.36.5",
    "react-native-quick-base64": "^3.0.1",
    "react-native-quick-crypto": "^1.1.6",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "uniwind": "^1.12.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@codama/nodes-from-anchor": "^1.5.6",
    "@codama/renderers-js": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@react-native/babel-preset": "~0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/react": "~19.2.14",
    "@vitest/coverage-v8": "^4.1.10",
    "codama": "^1.11.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~57.0.0",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10",
    "vitest-native": "^0.9.0"
  },
  "private": true
}
