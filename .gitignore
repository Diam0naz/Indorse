# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
expo-env.d.ts

# Native
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# tests
coverage/

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local
.env

# EAS submit credentials — the Play service account key is a machine identity,
# never committed (eas.json points submit.production at it)
google-service-account.json
*.keystore

# typescript
*.tsbuildinfo

app-example

# generated native folders
/ios
/android

# build artifacts (defense in depth — also covered by /android)
*.apk
*.aab

# agent tooling (worktrees, installed skills, tool configs — regenerable
# per machine, not app source)
.kilo/
.agents/
.claude/

# generated video/motion outputs (dated artifact dirs)
brag-output-*/

# HyperFrames deck build caches — thumbnails and preview HTML are regenerated
# by `hyperframes preview` / `snapshot` on every run
deck/.thumbnails/
deck/.hyperframes/

# nested Anchor workspace install (the root node_modules/ rule doesn't reach
# two levels deep) — regenerable from programs/indorse_program/package.json
programs/indorse_program/node_modules/

# Anchor / Solana program build (target/deploy holds the program keypair,
# test-ledger holds validator/faucet keypairs — never commit those)
programs/**/target/
programs/**/test-ledger/

# local validator ledger created when a root-level solana-test-validator runs
/test-ledger/
