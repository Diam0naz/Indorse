# ── App (exposed to the client bundle) ────────────────────────────────
# URL of the classification proxy. Point at a local `vercel dev` during POC.
EXPO_PUBLIC_AI_CLASSIFY_URL=http://localhost:3000/api/classify

# Dev/demo only: pretend this device is a Seeker to preview the "Seed Vault
# secured" camera badge and the Seeker Midnight theme on any handset.
# NEVER ship enabled — real verification is server-side SGT, not this flag.
# EXPO_PUBLIC_FORCE_SEEKER=true

# ── Proxy / serverless (never bundled into the app) ───────────────────
OPENAI_API_KEY=sk-...
# Optional — defaults to gpt-6-astra
OPENAI_VISION_MODEL=gpt-6-astra

# Google Gemini backend for POST /api/classify-gemini (free tier).
# Create a key at https://aistudio.google.com → Get API key.
GEMINI_API_KEY=AIza...
# Optional — defaults to gemini-3.5-flash-lite (multimodal, generous
# free-tier quota; gemini-3.8-flash allows only ~20 free requests/day)
GEMINI_MODEL=gemini-3.5-flash-lite

# Dev allowlist for POST /api/siws/verify, checked after Sign-in-with-Solana.
# Comma-separated base58 addresses; '*' allows any verified wallet (dev only,
# the real SGT on-mainnet check replaces this seam later). Empty = deny all.
SGT_DEV_ALLOWLIST=
SIWS_DOMAIN=indorse.app
SIWS_URI=https://indorse.app

# Transactional email for POST /api/email/start (email verification / recovery).
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=re_...
# Optional — defaults to Resend's sandbox sender (only delivers to your own
# inbox until a sending domain is verified).
# EMAIL_FROM=Indorse <verify@your-domain.com>

# ── Solana Attestation Service (optional) ────────────────────────────
# Enables writing an "email verified" attestation once the email code checks
# out. Leave BLANK to keep verification email-only (nothing on-chain).
# All three below must be set to turn it on; the issuer is
# api/_lib/sas-issuer.ts.
SAS_ISSUER_SECRET=
SAS_CREDENTIAL_PDA=
SAS_SCHEMA_PDA=
# SAS_RPC_URL=                     # optional — defaults to the app's cluster
# SAS_EMAIL_PEPPER=                # optional — hardens the on-chain email hash
#
# One-time devnet setup (npm run sas:bootstrap): creates the "indorse"
# credential and the "indorse.email" schema, then prints the three values
# above. These are read only by the bootstrap script, never by the app.
# SAS_AUTHORITY_SECRET=            # falls back to SAS_ISSUER_SECRET
# SAS_ACCOUNT_NAME=indorse
# SAS_SCHEMA_NAME=indorse.email
# SAS_EXTRA_SIGNERS=               # extra addresses allowed to write attestations


