# ── App (exposed to the client bundle) ────────────────────────────────
# URL of the classification proxy. Point at a local `vercel dev` during POC.
EXPO_PUBLIC_AI_CLASSIFY_URL=http://localhost:3000/api/classify-gemini
# Optional — comma-separated origins (or full URLs; origin is used) the app
# races with a liveness probe when an API request cannot CONNECT — dropped adb
# reverse tunnels, a moved DHCP lease. The first candidate that answers takes
# over for the rest of the session; HTTP error responses never trigger it.
# EXPO_PUBLIC_API_FALLBACKS=http://localhost:3000,http://192.168.1.50:3000

# Dev/demo only: pretend this device is a Seeker to preview the "Seed Vault
# secured" camera badge and the Seeker Midnight theme on any handset.
# NEVER ship enabled — real verification is server-side SGT, not this flag.
# EXPO_PUBLIC_FORCE_SEEKER=true

# ── Proxy / serverless (never bundled into the app) ───────────────────
OPENAI_API_KEY=sk-...
# Optional — defaults to gpt-6-astra
OPENAI_VISION_MODEL=gpt-6-astra
# Optional — "Ask indorse" failover model when Groq is down (assistant route
# balances GROQ_API_KEY → OPENAI_API_KEY); defaults to OPENAI_VISION_MODEL.
# OPENAI_ASSISTANT_MODEL=gpt-6-astra

# Google Gemini backend for POST /api/classify-gemini (free tier).
# Create a key at https://aistudio.google.com → Get API key.
GEMINI_API_KEY=AIza...
# Optional — defaults to gemini-3.5-flash-lite (multimodal, generous
# free-tier quota; gemini-3.8-flash allows only ~20 free requests/day)
GEMINI_MODEL=gemini-3.5-flash-lite

# Dev fast path for POST /api/siws/verify, checked after Sign-in-with-Solana.
# Comma-separated base58 addresses; '*' allows any verified wallet (dev only).
# A miss fails closed — unless SGT_RPC_URL below enables the real gate.
# May be overridden at runtime by the admin console.
SGT_DEV_ALLOWLIST=
# Funds-tier tier2 ("verified operators") — a SEPARATE list from the
# sign-in allowlist above, checked only by POST /api/funds-tier. Comma-
# separated base58 addresses; empty/missing keeps every wallet on the $100
# base tier. No '*' wildcard is honoured here — unlike the dev list, this one
# is what "verified" means, so a wildcard would grant the $250 ceiling to
# every wallet. May be overridden at runtime by the admin console.
OPERATOR_ALLOWLIST=
# Server-side Seeker Genesis Token check — enables the REAL mainnet gate:
# an allowlist miss in POST /api/siws/verify and the `seeker` claim in
# POST /api/funds-tier both fall through to it (verdict + mint recorded
# server-side; RPC outage answers 503, never "no SGT"). SGTs exist only on
# mainnet, so unset = legacy/dev behaviour (tests stay offline). Point at
# your provider, or the public default:
# SGT_RPC_URL=https://api.mainnet-beta.solana.com
SIWS_DOMAIN=indorse.app
SIWS_URI=https://indorse.app

# ── Shared SIWS nonce store (Serverless Redis — required on Vercel) ──
# A serverless host runs several instances, so the in-memory nonce store
# 401s any sign-in whose /api/siws/nonce and /api/siws/verify land on
# different instances. Set BOTH to use Upstash Redis over HTTP/REST (atomic
# GETDEL); leave blank and the store stays per-process, which is correct for
# `npm run api:dev` and the test suite. Grab these at
# https://console.upstash.com → your database → REST API.
# UPSTASH_REDIS_REST_URL=https://us1-….upstash.io
# UPSTASH_REDIS_REST_TOKEN=

# Transactional email for POST /api/email/start (email verification / recovery).
# Create a key at https://resend.com/api-keys.
RESEND_API_KEY=re_...
# Optional — defaults to Resend's sandbox sender (only delivers to your own
# inbox until a sending domain is verified).
# EMAIL_FROM=Indorse <verify@your-domain.com>

# ── Solana Attestation Service (optional) ────────────────────────────
# Enables writing an "email verified" attestation once the email code checks
# out. Leave BLANK to keep verification email-only (nothing on-chain).
# All three below must be set to turn it on; the issuer is
# api/_lib/sas-issuer.ts.
SAS_ISSUER_SECRET=
SAS_CREDENTIAL_PDA=
SAS_SCHEMA_PDA=
# SAS_RPC_URL=                     # optional — defaults to the app's cluster
# SAS_EMAIL_PEPPER=                # optional — hardens the on-chain email hash
#
# One-time devnet setup (npm run sas:bootstrap): creates the "indorse"
# credential and the "indorse.email" schema, then prints the three values
# above. These are read only by the bootstrap script, never by the app.
# SAS_AUTHORITY_SECRET=            # falls back to SAS_ISSUER_SECRET
# SAS_ACCOUNT_NAME=indorse
# SAS_SCHEMA_NAME=indorse.email
# SAS_EXTRA_SIGNERS=               # extra addresses allowed to write attestations


