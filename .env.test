# Override dev-only flags for the test environment.
# Vitest (Vite) loads .env.test after .env, so these values take precedence.
#
# EXPO_PUBLIC_FORCE_SEEKER is set to true in .env for on-device Seeker preview.
# Tests that assert the badge is hidden off-Seeker must run without it.
EXPO_PUBLIC_FORCE_SEEKER=
